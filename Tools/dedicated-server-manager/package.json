{
  "name": "extraction-dedicated-server-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated server + registry panel for host PC",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.extraction.dedicated-server",
    "productName": "Extraction Dedicated Server",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server-registry",
        "to": "registry",
        "filter": ["index.js", "package.json", "node_modules/**/*"]
      }
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "ExtractionDedicatedServer-${version}-win.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "ExtractionDedicatedServer-${version}-mac.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  }
}
