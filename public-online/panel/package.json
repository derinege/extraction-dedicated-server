{
  "name": "extraction-public-server-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated server panel — public internet mode (same UI as Tailscale panel)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node ./node_modules/electron/cli.js .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.extraction.public-server",
    "productName": "Extraction Dedicated Server",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../Tools/server-registry",
        "to": "registry",
        "filter": ["index.js", "package.json", "node_modules/**/*"]
      }
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "ExtractionPublicServer-${version}-win.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  }
}
